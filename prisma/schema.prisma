generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  entries     Entry[]
  settings    Settings?
  monthLocks  MonthLock[]
}

model MonthLock {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  year      Int
  month     Int       // 1-12

  lockedAt  DateTime  @default(now())

  @@unique([userId, year, month])
  @@index([userId])
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  date      String
  type      String   @default("normal")
  von       String?
  bis       String?
  pause     Int      @default(0)
  bemerkung String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model Settings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  wochenstunden  Float    @default(38.5)
  darkMode       Boolean  @default(false)
  emailTo        String   @default("")
  setupDone      Boolean  @default(false)
  employees      Json     @default("[]")
  smtpUser       String   @default("")
  smtpPass       String   @default("")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Session {
  sid       String   @id
  data      String
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
